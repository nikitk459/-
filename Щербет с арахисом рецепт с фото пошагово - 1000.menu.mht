ol.instructions { list-style: none; margin: 0px; padding: 0px; display: flex; -webkit-box-orient: horizontal; -webkit-box-direction: normal; flex-flow: wrap; place-content: flex-start space-between; -webkit-box-pack: justify; -webkit-box-align: stretch; align-items: stretch; }

ol.instructions li { flex-basis: 100%; }

ol.instructions li.wide-step { flex-basis: 100%; }

ol.instructions li.as-ad-step { padding: 1rem 0px; }

ol.instructions li.as-ad-step .step-ad-content { display: flex; min-height: 300px; height: 100%; width: 100%; -webkit-box-align: center; align-items: center; -webkit-box-pack: start; justify-content: flex-start; }

ol.instructions li.as-video-step { place-self: center; max-width: 100%; }

ol.instructions li img.photo { display: block; margin-bottom: 1rem; max-width: 100%; border-radius: 0.5rem; }

ol.instructions li .details-toggler { display: none; }

