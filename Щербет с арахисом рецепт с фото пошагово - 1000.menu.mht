ol.instructions li .mode-selector { margin-top: -0.6rem; margin-bottom: -1rem; text-align: right; }

ol.instructions li .mode-selector button { margin: 0px; padding: 0.15rem 0.5rem; display: inline-flex; background: rgb(246, 249, 254); }

ol.instructions li .mode-selector button svg { margin: 0.25rem 0.15rem; }

ol.instructions li .mode-selector button svg { fill: rgb(150, 190, 242); }

ol.instructions li .mode-selector button svg.is-active { fill: rgb(72, 74, 216); }

ol.instructions li .mode-selector button:hover { background: rgb(217, 234, 255); }

@media (min-width: 500px) {
  ol.instructions li { flex-basis: 48%; }
}

.instruction { margin: 1rem 0px; }

.instruction p { margin-top: 0px; margin-bottom: 0.5rem; }

.instruction p:last-child { margin-bottom: 0px; }

#prep_info_text .expand-info-button, #prep_info_text .fade-overlay { display: none; }

#prep_info_text .bi:first-child { margin-top: 1rem; }

p.infoblock { font-weight: 700; cursor: pointer; display: block; margin: 0px 0px -1px; padding: 0px 0px 0.5rem; }

p.infoblock:hover { text-decoration: underline 1px dashed; }

p.infoblock::before { content: ""; display: inline-block; background: 0px 0px; margin-right: 0.5rem; border-top: 0.4rem solid transparent; border-bottom: 0.4rem solid transparent; border-left: 0.5rem solid rgb(81, 81, 81); transition: transform 0.2s, -webkit-transform 0.2s; width: 0.5rem; height: 0.5rem; }

p.infoblock.expanded::before { transform: rotate(90deg); }

p.infoblock + p { margin: 0px 0px 1rem; display: none; background: rgb(244, 244, 244); padding: 0.5rem 1rem; border-radius: 0.25rem; }

@media screen {
  p.infoblock.expanded + p { display: block !important; }
}

p.infoblock.type-0 + p { background: rgb(239, 245, 253); }

p.infoblock.type-0::before { border-left-color: rgb(27, 113, 228); }

p.infoblock.type-1 + p { background: rgb(238, 247, 242); }

p.infoblock.type-1::before { border-left-color: rgb(33, 150, 83); }

p.infoblock.type-2 + p { background: rgb(255, 246, 242); }

p.infoblock.type-2::before { border-left-color: rgb(255, 84, 1); }

@media screen and (max-width: 500px) {
  p.infoblock { border-top: 1px solid rgb(225, 225, 225); border-bottom: 1px solid rgb(225, 225, 225); padding-top: 0.5rem; }
  p.infoblock.expanded { border-bottom: 1px solid transparent; }
}

@media print {
  p.infoblock { display: none !important; }
  p.infoblock + p { display: none !important; }
  p.infoblock.expanded { display: block !important; }
  p.infoblock.expanded + p { display: block !important; }
}

.fancybox-caption__body p.infoblock { margin-right: 1rem; }

.fancybox-caption__body p.infoblock + p { color: rgb(0, 0, 0); text-shadow: none; }

.view-modes-box input { display: none; }

.view-modes-box label.selected { color: rgb(255, 255, 255); background: linear-gradient(45deg, rgb(101, 91, 233), rgb(5, 96, 217)); }

